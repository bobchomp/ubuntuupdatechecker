# /etc/update-checker/secret.env  (root:root, chmod 600)
# Template only - install.sh asks for the real values and writes this file
# on the machine itself. Never commit the real file.

# Resend API key (https://resend.com/api-keys) - "Sending access" is enough.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: GitHub token (no scopes needed) to raise the GitHub API limit
# from 60 to 5000 requests/hour for github: release sources.
GITHUB_TOKEN=

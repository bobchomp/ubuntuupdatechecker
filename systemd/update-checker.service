[Unit]
Description=Report-only update checker (emails an update report)
Documentation=https://github.com/bobchomp/ubuntuupdatechecker
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
# --scheduled: only sends a report when one is due on the shared schedule
ExecStart=/usr/local/sbin/update-checker --scheduled
StateDirectory=update-checker
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
# Be gentle on the machine
Nice=10
IOSchedulingClass=idle
PrivateTmp=yes
TimeoutStartSec=45min

[Unit]
Description=update-checker shared schedule (daily trigger at 07:00 UK time)

[Timer]
# Every machine fires at the same moment: 07:00 UK time, whatever the
# machine's own timezone (DigitalOcean droplets default to UTC). The script
# (--scheduled) sends a report only on the shared report days, every 3 days.
# Keep in step with SCHEDULE_* in update_checker.py; a test checks this.
OnCalendar=*-*-* 07:00:00 Europe/London
# If the machine was off at 07:00, run once when it starts up again, so a
# missed report is sent late rather than skipped.
Persistent=true
# Start on time; systemd would otherwise allow up to a minute of slack.
AccuracySec=1s
Unit=update-checker.service

[Install]
WantedBy=timers.target
